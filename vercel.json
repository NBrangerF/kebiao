{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build",
    "installCommand": "npm install",
    "outputDirectory": "dist",
    "functions": {
        "api/cards/[...path].ts": {
            "maxDuration": 15,
            "includeFiles": "{public/data/{manifest.json,starmap.json,indexes/code_to_subject.json,by_subject/**,v2/manifest.json,v2/by_subject/**},node_modules/@fontsource/{noto-serif-sc/{400.css,files/*-{400,900}-normal.woff},ibm-plex-mono/files/ibm-plex-mono-latin-500-normal.woff}}"
        },
        "api/v1/[...path].ts": {
            "maxDuration": 120,
            "supportsCancellation": true,
            "includeFiles": "{public/data/**,data/textbooks/library-state/**,data/textbooks/catalog/**,data/textbooks/lesson-text/**,docs/api/**,node_modules/swagger-ui-dist/swagger-ui.css,node_modules/swagger-ui-dist/swagger-ui-bundle.js}"
        }
    },
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
            ]
        },
        {
            "source": "/((?!api/).*)",
            "headers": [
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                { "key": "Content-Security-Policy", "value": "object-src 'none'; base-uri 'self'; frame-ancestors 'self'" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/api",
            "destination": "/open-data",
            "permanent": true
        },
        { "source": "/glossary", "destination": "/concepts", "permanent": true },
        { "source": "/textbooks/pf_968d4f7e49f2401aa535/standards", "destination": "/textbooks/ed_f98cd7fabeaea0d2803d/standards", "permanent": true },
        { "source": "/textbooks/pf_968d4f7e49f2401aa535", "destination": "/textbooks/ed_f98cd7fabeaea0d2803d", "permanent": true },
