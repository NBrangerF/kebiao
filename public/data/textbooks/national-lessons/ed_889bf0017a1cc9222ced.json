age":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LS-01.3"],"align":[["EN-S1-LS-01.3","T","Read and answer.","book",11],["EN-S1-TH-01.15","P","Bus drivers and taxi drivers work at night.","book",11]]},{"id":"a6eec0e5-7839-0c3f-b093-a04b46510daa","title":"Unit 1_Fuel up_1 Listen and chant.","chapters":["Unit 1 People at work","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-TX-01.1"],"align":[["EN-S1-TX-01.1","T","Listen and chant.","book",13],["EN-S1-TH-01.15","P","What does Jake do？","book",13],["EN-S1-LK-01.4","P","Listen and chant.","book",13]]},{"id":"a8f6ba25-8e7d-4f88-9c0f-f34123b00df7","title":"Unit 1_Fuel up_3 Listen and match.","chapters":["Unit 1 People at work","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-TH-01.15"],"align":[["EN-S1-TH-01.15","T","He's a cleaner...","book",14],["EN-S1-LK-01.6","P","Listen and match.","book",14],["EN-S1-TX-01.4","P","He's a cleaner...","book",14]],"goals":{"take":"通过听录音并看图，把所听到的职业短句与相应图片配对，识别常见职业词汇与人物介绍句式（He’s a ...）。","later":"","items":[["学生能在听录音并查看教材图片的情境下，把所听到的职业短句与对应图片连线或圈出，并能模仿朗读He’s a …的句子。",["EN-S1-TH-01.15","EN-S1-LK-01.6"],"常见职业与人们的生活","能正确为4–6幅图片连线匹配并用He’s a …完整朗读句子"]]}},{"id":"38d62dfb-9341-d720-b2c7-25a6b35891d9","title":"Unit 1_Fuel up_4 Listen again and write.","chapters":["Unit 1 People at work","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-TH-01.15"],"align":[["EN-S1-TH-01.15","T","He's a cleaner...","book",14],["EN-S1-LK-01.6","P","Listen and match.","book",14],["EN-S1-TX-01.4","P","He's a cleaner...","book",14]],"goals":{"take":"在重复听句子的基础上，能根据听到的职业词写出相应的词或完成简单句，巩固职业词汇的拼写与句型He’s a …。","later":"","items":[["学生能在听录音的情境中，根据所听句子将职业词或句子内容写在空格处，准确拼写常见职业词。",["EN-S1-TH-01.15","EN-S1-LK-01.6"],"借助图片、实物理解词汇的意思","能在练习中为4–6处空格写出正确职业词或完整句He’s a …（拼写正确）"]]}},{"id":"069ec312-973d-351a-6ee1-5477d3d1838d","title":"Unit 1 People at work (Hit it big)","chapters":["Unit 1 People at work","Hit it big"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.11","EN-S1-TX-01.4"],"align":[["EN-S1-LK-01.11","T","What does he / she do！ -He's / She's a..","book",17],["EN-S1-TX-01.4","T","Draw and write about your dream job.","book",16],["EN-S1-TH-01.15","P","Unit 1 People at work","title",null],["EN-S1-LS-01.18","P","Read and write.","book",15]],"goals":{"take":"在语境中用 What does he/she do? — He's/She's a... 描述职业，并能画图并用简单句写出梦想职业。","later":"关于职业与社会文化的深入讨论留在后续单元扩展。","items":[["学生能在看图情境中用句型 What does he/she do? — He's/She's a... 问答并描述人物职业。",["EN-S1-LK-01.11"],"在语境中运用所学语法知识描述人和物","能用完整句型回答并描述图片中人物的职业。"],["学生能根据提示画出自己的梦想职业并用一到两句英文写出职业名称和一句描述。",["EN-S1-TX-01.4","EN-S1-LS-01.18"],"人物介绍、物品介绍、地点介绍等","能画图并写出类似 “She's a doctor.” 的一句话，字母拼写基本正确并能朗读。"]]}},{"id":"327a703f-8cdf-7766-a637-cd86b4dae4e5","title":"Unit 1 People at work (Wrap up & Check it & Let's explore)","chapters":["Unit 1 People at work","Let's explore"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.11"],"align":[["EN-S1-LK-01.11","T","What does he / she do！ -He's / She's a..","book",17],["EN-S1-TH-01.15","P","Unit 1 People at work","title",null],["EN-S1-LS-01.18","P","Write the word.","book",17]],"goals":{"take":"在情境中用What does he/she do?和He/She's a…进行简短问答，能正确书写本课职业词汇。","later":"更复杂的职业描述与扩展交流练习留到后续单元深化","items":[["学生能在课堂情境中根据图片或同伴，准确用What does he/she do?提问并用He/She's a…作出6个简短回答。",["EN-S1-LK-01.11"],"在语境中运用所学语法知识描述人和物","对6幅职业图片能全部用问答句正确说出职业名称"],["学生能将本单元常见的职业与人们生活联系起来，通过看图说出每个职业的一个工作场所或工作对象（每人至少说出2项）。",["EN-S1-TH-01.15"],"常见职业与人们的生活","能说出如“She's a teacher — she works at school”等至少2个对应句子"],["学生能在练习册上正确、工整地书写本课的职业单词，拼写无误且字母大小写使用正确（至少8词）。",["EN-S1-LS-01.18"],"正确书写字母、单词和句子","抄写或填写词汇练习时，8词拼写正确、书写规范"]]}},{"id":"4ccd7665-4e30-4f73-749d-f6773e13a517","title":"Unit 2_Words and expressions","chapters":["Unit 2 How do you feel today?"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LK-01.11"],"align":[["EN-S1-LK-01.11","T","use \"-What does he / she do！ -He's / She's a..\" to talk abou","book",17],["EN-S1-LS-01.12","P","Ifeel happy. Ilaugh and dance around.","book",19]]},{"id":"da294dca-084d-a2fc-1e9c-5997f9dac6eb","title":"Unit 2 How do you feel today？(Get ready)","chapters":["Unit 2 How do you feel today?","Get ready"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.7"],"align":[["EN-S1-LK-01.7","T","Learn the words","book",20]]},{"id":"bbe6f0eb-bca1-f625-4e76-90aac9bda3e5","title":"Unit 2_Get ready_1 Listen and sing.","chapters":["Unit 2 How do you feel today?","Get ready"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.9"],"align":[["EN-S1-LS-01.9","T","Listen and sing.","title",null]]},{"id":"85f02f6c-c987-1aff-d8f3-2233a1e36380","title":"Unit 2 How do you feel today？(Start up)","chapters":["Unit 2 How do you feel today?","Start up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LC-01.4"],"align":[["EN-S1-LC-01.4","T","Learn the words","book",20]]},{"id":"c1fcf832-3954-8c47-7657-cab2e0525dac","title":"Unit 2_Start up_1 Read and answer.","chapters":["Unit 2 How do you feel today?","Start up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.12"],"align":[["EN-S1-LS-01.12","T","She can't take part in the show today. She's sad.","book",21]]},{"id":"b29ae458-72aa-1508-8793-d075ffe59165","title":"Unit 2 How do you feel today？(Speed up)","chapters":["Unit 2 How do you feel today?","Speed up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LS-01.10"],"align":[["EN-S1-LS-01.10","T","Unit 2 How do you feel today？(Speed up)","title",null]]},{"id":"3a7f579c-c34e-d7c7-ae1f-3aed75d33d72","title":"Unit 2_Speed up_1 Read and answer.","chapters":["Unit 2 How do you feel today?","Speed up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.12"],"align":[["EN-S1-LS-01.12","T","She's sad.","book",21],["EN-S1-TX-01.2","P","I'm sorry to hear that.","book",21]]},{"id":"6532c836-ad9c-9546-9065-5389afba9612","title":"Unit 2 How do you feel today？(Fuel up)","chapters":["Unit 2 How do you feel today?","Fuel up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LC-01.4"],"align":[["EN-S1-LC-01.4","T","I'm feeling better now.","book",21],["EN-S1-TX-01.2","P","I'm sorry to hear that.","book",21]]},{"id":"9fccd217-fe76-edb0-0d1f-f0e3f55ae568","title":"Unit 2_Fuel up_1 Listen and chant.","chapters":["Unit 2 How do you feel today?","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LC-01.3"],"align":[["EN-S1-LC-01.3","T","These cute little faces， Have feelings to show.","book",25],["EN-S1-CA-03.3","P","They use colours, not words.","book",25]]},{"id":"4c5ba3b9-0f87-265b-6b87-8221a43e8fe3","title":"Unit 2_Fuel up_3 Listen and number.","chapters":["Unit 2 How do you feel today?","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.12"],"align":[["EN-S1-LS-01.12","T","How do I feel！ You feel angry.","book",26],["EN-S1-LC-02.4","P","Listen and number.","book",26]]},{"id":"ed7c3147-9e4f-552e-cf27-3b58cc7f439e","title":"Unit 2_Fuel up_4 Listen again and colour.","chapters":["Unit 2 How do you feel today?","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.12"],"align":[["EN-S1-LS-01.12","T","How do I feel！ You feel angry.","book",26],["EN-S1-LC-02.4","P","Listen and number.","book",26]],"goals":{"take":"听录音，根据语音和语句把对应的情绪图片按顺序编号并上色，能辨别说话人的情绪与态度。","later":"","items":[["学生能在听录音并观看课本图片的情境中，按照听到的句子把对应的情绪图片编号并给出正确颜色（按教师要求上色）。",["EN-S1-LS-01.12"],"表达简单的情感和喜好","能把录音中出现的情绪与课本图片对应并上色，顺序与录音一致。"],["学生能借助说话人的语音、语调和面部表情判断说话者的情绪，并据此在听力活动中给图片正确编号。",["EN-S1-LC-02.4"],"借助语音、语调、手势、表情等判断","能说出每段录音的情绪（如 angry/happy/sad）并把相应图片标序。"]]}},{"id":"bc710673-ab0d-60af-4fa6-9853b08094f8","title":"Unit 2 How do you feel today？(Hit it big)","chapters":["Unit 2 How do you feel today?","Hit it big"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LS-01.12","EN-S1-LK-01.11"],"align":[["EN-S1-LS-01.12","T","Now I can name feelings：","book",29],["EN-S1-LK-01.11","T","use \"I'm feeling / doing..\"","book",29]],"goals":{"take":"能用“I’m feeling …/I’m doing …”在语境中说出并命名常见的情绪，进行简短交流与自我表达。","later":"","items":[["学生能在配图或情境提示下，用“I’m feeling + 感受词”口头说出并命名人物的情绪（每人说一句，能连贯表达）。",["EN-S1-LS-01.12"],"表达简单的情感和喜好","能完整说出如“I'm feeling happy.”、“I'm feeling angry.”等句子并指向相应图片。"],["学生能在教师指导的对话情境中，用“I’m feeling …/I’m doing …”描述自己或描写人物，进行一问一答的简短交流。",["EN-S1-LK-01.11"],"在语境中运用所学语法知识描述","能与同伴完成一轮问答：How do you feel today?—I'm feeling …. / I'm doing …. 。"]]}},{"id":"f2711e5d-85e2-b556-5044-9d16391bafdf","title":"Unit 2 How do you feel today？(Wrap up & Check it & Let's explore)","chapters":["Unit 2 How do you feel today?","Let's explore"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1},{"id":"93246d2d-41fb-f665-68b1-f06a58e276b8","title":"Unit 2_Let’s explore_1 Listen and write.","chapters":["Unit 2 How do you feel today?","Let's explore"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1},{"id":"64611ad9-1f40-a264-138d-f5d0c889d172","title":"Unit 3_Words and expressions","chapters":["Unit 3 Everyone's got talent!"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LK-01.7"],"align":[["EN-S1-LK-01.7","T","happy • worried excited happy sad","book",30],["EN-S1-LK-01.11","P","You can play the piano. Ican act.","book",31],["EN-S1-TX-01.1","P","Talents make us shine！","book",31]],"goals":{"take":"能根据图片或提示说出本课重点词汇与短语，并用 I can 构成简单句描述会做的才艺（能说、读出）。","later":"","items":[["学生能在看图片或听示范的情况下，说出本课的情绪词和形容词短语（如 happy、worried、excited、sad）。",["EN-S1-LK-01.7"],"说出单词和短语","对着图片能正确说出相应的词并发音，至少8/10次准确"],["学生能用教材给出的句型（I can … / You can …）根据图片或同伴表演，说出自己或他人会做的才艺（如 I can play the piano）。",["EN-S1-LK-01.11"],"在语境中运用所学语法知识描述人和物","能用 I can / You can 句型描述至少两幅图片中的才艺"],["学生能跟唱或朗读教材短句 Talents make us shine！并在节奏中说出短语。",["EN-S1-TX-01.1"],"歌谣、歌曲、韵文","能完整朗读或跟唱该短句，语音、节奏大致准确"]]}},{"id":"c5bcaa10-0d4e-0e2b-312b-32dfafb8a860","title":"Unit 3 Everyone's got talent! (Get ready)","chapters":["Unit 3 Everyone's got talent!","Get ready"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.11"],"align":[["EN-S1-LK-01.11","T","Ican Ican Ican","book",32]],"goals":{"take":"在主题语境中用 I can 句型进行简单自我或他人描述与交流，能造句说出自己会的才艺。","later":"","items":[["学生能在小组交流活动中用 I can 句型说出自己或同伴会做的事（每人至少说两句）。",["EN-S1-LK-01.11"],"在语境中运用所学语法知识描述人和物","在对话或轮流发言中能连贯说出两句 I can … 的句子"]]}},{"id":"efa22606-b4ab-940e-819b-2d5be815f880","title":"Unit 3_Get ready_1 Listen and sing.","chapters":["Unit 3 Everyone's got talent!","Get ready"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-TX-01.1"],"align":[["EN-S1-TX-01.1","T","Listen and sing.","title",null],["EN-S1-LK-01.11","P","Ican Ican Ican","book",32]],"goals":{"take":"通过听唱活动掌握并能跟唱本课歌谣，能在歌中识别并说出 I can 句型的例子。","later":"","items":[["学生能在听与跟唱活动中准确复述歌中 I can 句型的短句，并能跟唱完整段落。",["EN-S1-TX-01.1","EN-S1-LK-01.11"],"歌谣、歌曲、韵文","能跟唱一段并能说出歌中两处 I can … 的例句"]]}},{"id":"ce594284-1be5-670b-fd4c-26ecef59e567","title":"Unit 3 Everyone's got talent! (Start up)","chapters":["Unit 3 Everyone's got talent!","Start up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.6"],"align":[["EN-S1-LK-01.6","T","Learn the words","book",32]]},{"id":"b7bb9c20-92bb-3519-ef74-dffd6334933c","title":"Unit 3_Start up_1 Read and answer.","chapters":["Unit 3 Everyone's got talent!","Start up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LK-01.11"],"align":[["EN-S1-LK-01.11","T","I can't dance well. Can you teach me?","book",34]]},{"id":"c03a147d-5f19-1322-c614-37a4b1046a86","title":"Unit 3 Everyone's got talent! (Speed up)","chapters":["Unit 3 Everyone's got talent!","Speed up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"align":[["EN-S1-LK-01.11","P","Unit 3 Everyone's got talent! (Speed up)","title",null]]},{"id":"d5f6ae23-67e7-8ad3-50c5-2413a505d27a","title":"Unit 3_Speed up_1 Read and answer.","chapters":["Unit 3 Everyone's got talent!","Speed up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.16"],"align":[["EN-S1-LS-01.16","T","What is Lingling doing？","book",34],["EN-S1-LC-01.6","P","The best dancer Who is the best dancer？","book",33]]},{"id":"4fc18168-3e63-4ba8-cca0-1ba50b5721ae","title":"Unit 3 Everyone's got talent! (Fuel up)","chapters":["Unit 3 Everyone's got talent!","Fuel up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.7"],"align":[["EN-S1-LK-01.7","T","do dance teach learn","book",34],["EN-S1-LC-01.6","P","Welcome to the dance show！","book",33]]},{"id":"f2bdcbf7-0db1-8bc2-73e5-2839d0042283","title":"Unit 3_Fuel up_1 Listen and chant.","chapters":["Unit 3 Everyone's got talent!","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-TX-01.1"],"align":[["EN-S1-TX-01.1","T","Listen and chant.","book",37],["EN-S1-LS-01.10","P","I write all the time.","book",37]]},{"id":"de4196fb-c3e4-8d10-99e7-435b5c893e09","title":"Unit 3_Fuel up_3 Listen and number.","chapters":["Unit 3 Everyone's got talent!","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LC-01.6"],"align":[["EN-S1-LC-01.6","T","This is Grandma Li. She's painting. She works hard.","book",38],["EN-S1-LK-01.10","P","She's painting.","book",38]],"goals":{"take":"借助图片听短文，能理解并根据画面给出基本信息，能识别并说出现在进行时的句子（She's painting.）。","later":"","items":[["学生能边看图片边听短文，找出并说出短文提到的基本信息（如人物、正在做的事）。",["EN-S1-LC-01.6"],"读懂语言简单的小故事，理解基本信息","能回答关于人物和其正在做的事的两三个问题（口头简答）"]]}},{"id":"41fc4e4a-ac32-a64c-7640-09a731141fe4","title":"Unit 3 Everyone's got talent! (Hit it big)","chapters":["Unit 3 Everyone's got talent!","Hit it big"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LS-01.11","EN-S1-LK-01.11"],"align":[["EN-S1-LS-01.11","T","Ask your family about their talents and write.","book",39],["EN-S1-LK-01.11","T","She's good at doing magic.","book",40],["EN-S1-TX-01.4","P","My family's talents","book",39]],"goals":{"take":"通过询问并记录家庭成员的才艺，能用 be good at + doing 描述人物特长并做简单介绍（口头与书面）。","later":"","items":[["学生能在课堂对话或家庭访谈中询问并写出两到三项家庭成员的才艺，每项用一句话记录。",["EN-S1-LS-01.11"],"交流简单的个人和家庭信息","能写出并读出三句如：My dad can play the guitar. He’s good at playing the guitar."],["学生能在示例句和配对练习中用 She's/He's good at + doing 描述人物正在做的才艺，正确改写并朗读三句。",["EN-S1-LK-01.11"],"运用所学语法知识描述人和物","能把 He can do magic. 改写为 He’s good at doing magic 并朗读"],["学生能根据教材提示，将收集到的家庭才艺整理成一段简短的人物介绍（2–3句）。",["EN-S1-TX-01.4"],"人物介绍","能说出或写出一段如：My family's talents. My sister is good at dancing."]]}},{"id":"f94fd701-771d-1041-0172-91b3349793d3","title":"Unit 3 Everyone's got talent! (Wrap up & Check up & Let's explore)","chapters":["Unit 3 Everyone's got talent!","Wrap up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.11"],"align":[["EN-S1-LK-01.11","T","Now I can name talents： use “What / Why are you doing..？\"","book",41],["EN-S1-TQ-02.1","P","There are different kinds of talent.","book",42],["EN-S1-TH-01.13","P","There are different kinds of talent.","book",42]],"goals":{"take":"巩固并能用疑问句询问与命名不同才艺，能根据图片或关键词归纳并说出几类才艺。","later":"更复杂的因果解释与扩展写作练习留在后续单元。","items":[["学生能根据教材图片或关键词把课堂中出现的才艺归类，指出至少两类并用一句话说明每类的代表活动。",["EN-S1-TQ-02.1"],"归纳语篇的重要信息","能说出两类如：performance talents（singing, dancing）；sports talents（skating）"]]}},{"id":"c33b1d75-5eb4-9ef5-559d-6adfb1d21160","title":"Unit 4_Words and expressions","chapters":["Unit 4 Plant life"],"pdf_page":null,"unit_id":null,"materials":[],"h