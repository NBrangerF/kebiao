_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.17","EN-S1-LC-01.3"],"align":[["EN-S1-LS-01.17","T","The man is sleeping. Some monkeys are playing in the tree.","book",81],["EN-S1-LC-01.3","T","I've got nice hats, nice hats, nice hats.","book",81]]},{"id":"8d9f7293-2249-cc38-8cac-1ef45e12c9bd","title":"Plays_Words and expressions in Plays","chapters":["Unit 6 Cool clothes"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LK-01.6"],"align":[["EN-S1-LK-01.6","T","dress 连衣裙 T-shirt T恤（衫）","book",90]]},{"id":"0e74de97-20d9-5fa8-c82e-53bf000eb8d3","title":"Proper nouns","chapters":["Unit 6 Cool clothes"],"pdf_page":80,"unit_id":"tcu_8880272b73e0c92f","materials":[],"hours":1,"align":[["EN-S1-TX-01.2","P","I've got nice hats, nice hats, nice hats.","book",81]]},{"id":"0956e8a2-ac55-1d62-d449-3ea4f263e864","title":"Unit 6 Cool clothes (Get ready)","chapters":["Unit 6 Cool clothes","Get ready"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.6"],"align":[["EN-S1-LK-01.6","T","Get ready Learn the words","book",68]],"goals":{"take":"借助图片和实物初步识记并理解本课核心词汇的基本意思与对应关系。","later":"具体句型运用与交际表达留给后续课。","items":[["学生能在教师出示图片或实物时，听到单词后能指向或连线出对应的图片或实物。",["EN-S1-LK-01.6"],"借助图片、实物理解词汇的意思","能将本课生词与对应图片或实物正确连线或指认。"]]}},{"id":"406d89fe-979d-f909-9b13-725d9ebf07c6","title":"Unit 6_Get ready_1 Listen and sing.","chapters":["Unit 6 Cool clothes","Get ready"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LC-01.3"],"align":[["EN-S1-LC-01.3","T","Listen and sing.","title",null]],"goals":{"take":"通过音视频大声跟读并完整跟唱本单元的歌曲或韵律材料，积累发音和语调。","later":"跟读后的口语交际练习放在后续会话环节。","items":[["学生能跟随音视频大声完整跟读并跟唱课文歌曲，模仿语音语调和节奏。",["EN-S1-LC-01.3"],"能大声跟读音视频材料","能跟唱整段材料并模仿主要单词和句子的发音与节奏。"]]}},{"id":"bbf0bb4e-4813-a346-0304-a7d32ddb1e0b","title":"Unit 6 Cool clothes (Start up)","chapters":["Unit 6 Cool clothes","Start up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"align":[["EN-S1-LK-01.6","P","Get ready Learn the words","book",68]]},{"id":"16bbb4c8-cf50-f5e7-5df9-8c98938c2162","title":"Unit 6_Start up_1 Read and answer.","chapters":["Unit 6 Cool clothes","Start up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.16"],"align":[["EN-S1-LS-01.16","T","He's wearing a T-shirt and shorts.","book",70],["EN-S1-LK-01.11","P","I'm looking for my blue dress.","book",69],["EN-S1-LS-01.4","P","Does Lingling wear her favourite dress to the party？","book",69]],"goals":{"take":"在看图片与短对话的情境中，用简单句子描述人物着装并进行与寻找物品相关的简单交流，能根据画面推断信息。","later":"更复杂的描述、扩展性对话与书面表达在后续课继续深化。","items":[["学生能看图片用 He's/She's wearing… 等句子描绘人物穿着（如 T-shirt and shorts）。",["EN-S1-LS-01.16"],"用简单的语句描述图片或事物","能说出并指认图片中人物的着装，如“He's wearing a T-shirt and shorts.”。"],["学生能在情境对话中用句子说出自己或他人正在找的衣物，如 I'm looking for my blue dress。",["EN-S1-LK-01.11"],"围绕相关主题，在语境中运用所学语法知识描述人和物，进行简单交流。","能完整说出句子“I'm looking for my blue dress.”并根据提示提问或回答。"],["学生能根据图片和对话推断并口头回答问题，如 Does Lingling wear her favourite dress to the party？并给出简单理由。",["EN-S1-LS-01.4"],"推断多模态语篇（如动画、图书及其他印刷品的封面和封底、邀请卡及贺卡）中的画面、图","能根据画面回答‘Yes/No’并用一句话说明理由。"]]}},{"id":"a05e979a-0108-9fc0-29f5-ce72bb626230","title":"Unit 6 Cool clothes (Speed up)","chapters":["Unit 6 Cool clothes","Speed up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.6"],"align":[["EN-S1-LK-01.6","T","Unit 6 Cool clothes","title",null],["EN-S1-TH-01.4","P","Unit 6 Cool clothes","title",null]],"goals":{"take":"通过图片复习并巩固本单元词汇，同时用简单句子表达对服装的喜好与情感。","later":"更丰富的文化比较与情感表达策略留在以后年级或扩展活动。","items":[["学生能借助图片或实物再次识记并准确指出本单元的服装词汇。",["EN-S1-LK-01.6"],"借助图片、实物理解词汇的意思","能看到图片能说出对应单词并指认图片。"],["学生能在展示不同衣物的情境中，用简单句子表达个人喜好，如 I like this dress / I don't like that hat。",["EN-S1-TH-01.4"],"个人喜好与情感表达","能用 I like / I don't like 句型说出至少一种对衣物的喜好。"]]}},{"id":"c13f3892-b2bf-00f4-90c8-84f089092e4a","title":"Unit 6_Speed up_1 Read and answer.","chapters":["Unit 6 Cool clothes","Speed up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.16"],"align":[["EN-S1-LS-01.16","T","He's wearing a T-shirt and shorts.","book",70],["EN-S1-LK-01.11","P","I'm looking for my blue dress.","book",69]],"goals":{"take":"本课在语境中用简单句描述他人穿着，并用简单句表达正在寻找的物品（颜色、种类）。","later":"把所学语句灵活用于更长对话或更多服饰词汇。","items":[["学生能在看图片和教材句子提示下，用句型“He's/She's wearing + 名词短语”用英文说出图片中人物的穿着，能正确使用1–2种服饰词。",["EN-S1-LS-01.16"],"用简单的语句描述图片或事物","看到人物图片能用完整句子说出如“He's wearing a T-shirt and shorts.”"],["学生能在小组配对练习中，根据提示句“I’m looking for my + 颜色 + 名词”用简单句说明自己在找什么，并回答同伴的寻物句子。",["EN-S1-LK-01.11"],"在语境中运用所学语法知识描述人和物","能说出“I’m looking for my blue dress.”并能用类似句子说出1–2个例子。"]]}},{"id":"af6a7856-4457-a1af-7af8-426dd0ff347f","title":"Unit 6 Cool clothes (Fuel up)","chapters":["Unit 6 Cool clothes","Fuel up"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S1-LK-01.10","EN-S1-LS-01.16"],"align":[["EN-S1-LK-01.10","T","Is Amy wearing a shirt and a skirt！","book",70],["EN-S1-LS-01.16","T","He's wearing a T-shirt and shorts.","book",70]]},{"id":"7f8afe60-b40e-e037-c589-05d9067016f6","title":"Unit 6_Fuel up_1 Listen and chant.","chapters":["Unit 6 Cool clothes","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LS-01.10","EN-S1-LS-01.9"],"align":[["EN-S1-LS-01.10","T","Listen and chant. We wear uniforms","book",73],["EN-S1-LS-01.9","T","We wear uniforms for school.","book",73]]},{"id":"2cf7ecb9-d5b2-679e-bbe7-9857ddd0a23c","title":"Unit 6_Fuel up_3 Listen and match.","chapters":["Unit 6 Cool clothes","Fuel up"],"pdf_page":null,"unit_id":null,"materials":[],"hours":1,"ai_points":["EN-S1-LC-02.1"],"align":[["EN-S1-LC-02.1","T","Listen and match.","book",74]]},{"id":"2ea22a60-4360-7461-701c-c27a10c56a0f","title":"Unit 6 Cool clothes (Hit it big)","chapters":["Unit 6 Cool clothes","Hit it big"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单","课后练习"],"hours":1,"ai_points":["EN-S