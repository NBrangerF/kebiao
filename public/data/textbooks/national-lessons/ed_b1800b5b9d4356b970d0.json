0","title":"探索规律","chapters":["总复习"],"pdf_page":null,"unit_id":null,"materials":["课件","教学设计","学习任务单"],"hours":1,"ai_points":["MA-S3-NA-02.3"],"align":[["MA-S3-NA-02.3","T","探索规律","title",null]]},{"id":"2919f577-6c3a-4de7-a1a8-23c48499410e","title":"圆锥的组成（底面）","chapters":["总复习","图形的认识"],"pdf_page":null,"unit_id":null,"materials":["课件"],"hours":1,"ai_points":["MA-S3-GG-01.4"],"align":[["MA-S3-GG-01.4","T","这个截面是一个三角形。","book",93],["MA-S3-GG-01.3","P","平面图形圆","book",93]]},{"id":"25d2e9d4-3cfc-4f53-e926-c440f3f634a1","title":"图形与测量","chapters":["总复习"],"pdf_page":97,"unit_id":"tcu_e5b40bb17ac0add7","materials":["课件","教学设计","学习任务单"],"hours":1,"ai_points":["MA-S3-GG-01.5"],"align":[["MA-S3-GG-01.5","T","测量要有 “单位” 。 为什么要用统一的“单位”呢？","book",97],["MA-S3-GG-01.2","P","分别说出已学过的多边形的面积计算公式","book",98],["MA-S3-GG-01.4","P","分别说出已学过的立体图形的体积计算公式","book",98]]},{"id":"2e0744f7-c9ef-b1b6-b682-a7aa359832f4","title":"图形的运动","chapters":["总复习"],"pdf_page":32,"unit_id":"tcu_ed12430c9ca8824e","materials":["课件","教学设计","学习任务单"],"hours":1,"ai_points":["MA-S3-GG-02.4","MA-S3-GG-02.5"],"align":[["MA-S3-GG-02.4","T","将小旗向上平移12格。","book",101],["MA-S3-GG-02.5","T","画出房子的另一半。","book",102]]},{"id":"9d5becce-ae62-4647-84ad-330ac8f5f545","title":"奇数和偶数","chapters":[],"pdf_page":null,"unit_id":null,"materials":["课件"],"hours":1,"ai_points":["MA-S3-NA-01.1"],"align":[["MA-S3-NA-01.1","T","奇数和偶数","title",null],["MA-S3-NA-01.2","P","奇数和偶数","title",null]],"goals":{"take":"本课侧重教会用“能被2整除”判断偶数并能找出若干数的2的倍数（初步识别与列举）。","later":"公倍数、因数、最大公因数、质数与合数的系统判断","items":[["学生能在课堂给定的自然数或数列中，通过观察末位或用除法说明并说出每个数是奇数还是偶数（口头或书面）。",["MA-S3-NA-01.1"],"能找出2，3，5的倍数","能为每个给定数打“√/×”并写出判断依据（例如“能被2整除”或“余1”）。"],["学生能在1～100或课堂给定范围内，列举若干数的2的倍数，并用列举法写出10以内自然数的所有2的倍数作为练习。",["MA-S3-NA-01.2"],"能找出10以内自然数的所有倍数","能正确写出10以内所有数的2的倍数（例如2,4,6,8,10）并能找出若干给定数的2的倍数。"]]}},{"id":"669b7cfe-f306-42dd-8b75-99d5c712d6f4","title":"小数的意义","chapters":[],"pdf_page":null,"unit_id":null,"materials":["课件"],"hours":1,"ai_points":["MA-S3-NA-01.3"],"align":[["MA-S3-NA-01.3","T","小数的意义","title",null]]},{"id":"ac8bf0d9-d923-4cda-8333-aeeb5283421d","title":"年、月、日之间的关系","chapters":[],"pdf_page":null,"unit_id":null,"materials":["课件"],"hours":1,"ai_points":["MA-S3-NA-01.6"],"align":[["MA-S3-NA-01.6","T","年、月、日之间的关系","title",null],["MA-S3-NA-02.2","P","年、月、日之间的关系","title",null]],"goals":{"take":"在与年、月、日换算和简单时段问题中，能选择并用恰当的四则运算求解；能作出合理估算并说明估算过程。","later":"更复杂的历法问题与闰年计算","items":[["学生能在提供的日常情境题（如把若干月换算成年和月、把天数换算成月和天）中，选择合适的运算方法并写出完整计算过程，得出正确结果。",["MA-S3-NA-01.6"],"选择恰当的运算方法解决问题","在两道换算题中写出换算步骤并得出正确答案。"],["学生能对涉及年、月、日的数量作出近似估算（如估算若干天约等于多少月或年），并用一句话写出所用的估算方法和结果的合理范围。",["MA-S3-NA-02.2"],"运用恰当的方法进行估算","给出估算结果并写出所用的近似方法与结果区间。"]]}},{"id":"28b0447f-ae82-4f09-8330-8669be776d57","title":"质数和合数","chapters":[],"pdf_page":null,"unit_id":null,"materials":["课件"],"hours":1,"ai_points":["MA-S3-NA-01.2"],"align":[["MA-S3-NA-01.2","T","质数和合数","title",null]],"goals":{"take":"对质数和合数的概念与判定方法进行初步学习，并能找出数的所有因数与判定质合（在1~100范围内练习）。","later":"10以内的倍数、公倍数与最小公倍数、两个数的公因数与最大公因数","items":[["学生能在课堂例题和练习中，对给定的不超过100的自然数，使用试除法或除法列出该数的所有因数。",["MA-S3-NA-01.2"],"能找出一个自然数的所有因数","把所给数的所有因数逐一写出并列成因数对"],["学生能在课堂情境中，通过对比除尽与否，判断并说明一个不超过100的自然数是质数还是合数。",["MA-S3-NA-01.2"],"能判断一个自然数是否是质数或合数","对所给数说出“质数”或“合数”并写出判定依据（如能被哪些小于它的数整除）"]]}}],"edition_grades":{"MA-S4-GG-01.1":[7,9],"MA-S4-GG-01.2":[7],"MA-S4-GG-01.4":[7],"MA-S4-GG-01.6":[7],"MA-S4-GG-02.1":[7],"MA-S4-GG-02.10":[7,8],"MA-S4-GG-02.11":[7],"MA-S4-GG-02.12":[7,8],"MA-S4-GG-02.13":[7],"MA-S4-GG-02.6":[7],"MA-S4-GG-02.9":[7],"MA-S4-GG-03.1":[7],"MA-S4-GG-03.10":[8],"MA-S4-GG-03.11":[8],"MA-S4-GG-03.12":[8],"MA-S4-GG-03.13":[8],"MA-S4-GG-03.14":[8],"MA-S4-GG-03.2":[7],"MA-S4-GG-03.4":[7],"MA-S4-GG-03.7":[7],"MA-S4-GG-03.8":[8],"MA-S4-GG-03.9":[7,8],"MA-S4-GG-04.1":[7,8],"MA-S4-GG-04.2":[9],"MA-S4-GG-04.3":[8,9],"MA-S4-GG-04.6":[8],"MA-S4-GG-05.1":[9],"MA-S4-GG-05.2":[9],"MA-S4-GG-05.3":[9],"MA-S4-GG-05.4":[9],"MA-S4-GG-05.5":[9],"MA-S4-GG-05.6":[9],"MA-S4-GG-05.8":[9],"MA-S4-GG-05.9":[7,9],"MA-S4-GG-07.1":[7,9],"MA-S4-GG-07.2":[7],"MA-S