{
  "book": {"subject": "数学", "grade": 5, "term": "下", "edition": "北师大版"},
  "misconceptions": [
    {"id": "bsd-frac-decimal-no-compare-5b", "name": "以为分数和小数不能比大小", "why": "觉得分数和小数是两种不同的数，没想到可以化成同一种再比。", "move": "让学生在 0 到 1 的尺子上分别找出 {3/5} 和 0.58 的位置，看哪个更靠右。"},
    {"id": "bsd-net-row-ends-5b", "name": "以为一行的头尾两个面相对", "why": "觉得一行里离得最远的两个面，折起来也离得最远。", "move": "用纸剪出这个展开图，先折 1 号，再折 3 号、4 号，看 4 号最后落在哪里。"},
    {"id": "bsd-surface-missing-pair-5b", "name": "表面积漏算了一组相对的面", "why": "算完上下、前后两组面就停了，忘了左、右两个面。", "move": "拿一个纸盒，算一组面就在纸盒上给这两个面打勾，看还有哪两个面没打勾。"},
    {"id": "bsd-exposed-each-three-5b", "name": "以为每个纸箱都露 3 个面", "why": "只想到 1 个纸箱放在墙角时露 3 个面，以为摆成一排后每个纸箱也露 3 个面。", "move": "用几个粉笔盒在讲台角上摆一排，一个一个地数：每个盒子哪几个面看得见？"},
    {"id": "bsd-exposed-end-forgot-5b", "name": "漏数了最外端纸箱的侧面", "why": "数了每个纸箱的上面和前面，忘了排在最外面的那个纸箱侧面也露着。", "move": "让学生走到这一排的最外端看一看：这一头还有没有看得见的面？"},
    {"id": "bsd-more-part-as-whole-5b", "name": "问多多少，却求成了一共多少", "why": "算出多出的 15 人后，又顺手加上了去年的 40 人。", "move": "画线段图，让学生指出“多出的部分”是哪一段，问题问的是哪一段。"},
    {"id": "bsd-frac-mult-add-den-5b", "name": "分子相乘，分母却相加", "why": "把分数加法里对分母的处理和乘法混在了一起。", "move": "折纸：先表示 {3/5}，再取它的 {2/5}，数一数整张纸一共被分成了几格。"},
    {"id": "bsd-frac-mult-smaller-5b", "name": "以为乘分数，积一定变小", "why": "学过的“求一个数的几分之几”里，分数都小于 1。", "move": "让学生算 6 × {7/6}，再问：乘的分数比 1 大还是比 1 小？"},
    {"id": "bsd-reciprocal-reverse-digits-5b", "name": "把小数的数字倒过来写", "why": "把“颠倒分子、分母”记成了把数字顺序倒过来。", "move": "让学生算 0.25 × 0.52，看积是不是 1；再把 0.25 化成分数找倒数。"},
    {"id": "bsd-more-cups-bigger-5b", "name": "以为倒的杯数多，杯子就大", "why": "只比了杯数的多少，没想到杯数多是因为每杯装得少。", "move": "用一个大杯和一个小杯分别往同一个空瓶里倒水，让学生看用哪种杯子要倒的杯数多。"},
    {"id": "bsd-same-juice-same-cup-5b", "name": "以为倒满同一个壶，杯子就一样大", "why": "把“倒满的是同一个水壶”和“两种杯子一样大”混在了一起。", "move": "问：同一壶水，倒 8 杯和倒 5 杯，每杯装的水一样多吗？"},
    {"id": "bsd-volume-area-unit-5b", "name": "体积用了面积单位", "why": "分不清平方厘米和立方厘米，看到“厘米”就选了。", "move": "拿出 1 cm^2 的小方片和 1 cm^3 的小正方体，问：量魔方占多大空间，要用哪一个去摆？"},
    {"id": "bsd-volume-unit-sense-5b", "name": "对体积单位有多大没感觉", "why": "只记住了单位名称，没有建立 1 cm^3、1 dm^3 的实际大小。", "move": "用手比出棱长 1 dm 的正方体，再和魔方比一比，180 个这么大的正方体会有多大？"},
    {"id": "bsd-cube-as-triple-5b", "name": "把 a^3 当成 3 × a", "why": "把“a 的立方”想成了 3 个 a 相加。", "move": "用小正方体摆一个棱长 2 cm 的正方体：要用 6 个还是 8 个 1 cm^3 的小正方体？"},
    {"id": "bsd-div-int-both-ways-5b", "name": "分子除以整数，分母又乘整数", "why": "把“分子除以 4”和“乘 4 的倒数”两种方法混在一起，各做了一半。", "move": "让学生分别只用一种方法算一次，比较结果，再看自己的做法多做了哪一步。"},
    {"id": "bsd-div-always-smaller-5b", "name": "以为商一定比被除数小", "why": "整数除法里见到的商都不比被除数大，就以为除法总是越除越小。", "move": "问：12 里面有几个 {3/4}？先画一画、数一数，再看结果比 12 大还是小。"},
    {"id": "bsd-frac-one-part-only-5b", "name": "只求出了一份是多少", "why": "算出 30 ÷ 3 = 10 就停了，忘了全班是 5 份。", "move": "画线段图把全班平均分成 5 份，涂出 3 份，问：1 份是多少？5 份呢？"},
    {"id": "bsd-direction-no-distance-5b", "name": "以为有了方向就能确定位置", "why": "只想到方向，没想到同一个方向上远近不同的点有很多。", "move": "从学校画出北偏东 30° 的射线，请几名学生在线上点出不同的点，问：哪一个是书店？"},
    {"id": "bsd-sum-times-forget-one-5b", "name": "把总数直接除以倍数", "why": "只看到“5 倍”，忘了文具盒自己也占 1 份，一共是 6 份。", "move": "画线段图：文具盒画 1 段，书包画 5 段，数一数 120 元一共对应几段。"},
    {"id": "bsd-times-answer-other-5b", "name": "求出的是另一个量", "why": "先求出了书包的价钱，没回头看问题问的是文具盒。", "move": "让学生先圈出问题里的“文具盒”，再检查自己求出的是不是它。"},
    {"id": "bsd-tallest-bar-total-5b", "name": "看到最高的直条就以为总数最多", "why": "只找了图中最高的那一个直条，没把同一类的两个直条合起来。", "move": "让学生在每类水果下面写出两个直条的和，再比较。"},
    {"id": "bsd-one-series-only-5b", "name": "只看了一种颜色的直条", "why": "只看了女生那一组直条，忘了问的是全班。", "move": "问：“全班”包括哪两组？图例里两种颜色各表示谁？"},
    {"id": "bsd-mean-of-means-5b", "name": "把原平均数和新数直接平均", "why": "把 90 当成了一个人的成绩，没想到 90 代表的是 4 个人。", "move": "先问：4 个人一共多少分？加上新同学后一共多少分？几个人分？"},
    {"id": "bsd-mean-unchanged-5b", "name": "以为加入一个数，平均数不变", "why": "觉得原来的平均数已经算好了，没想到任何一个数变了，平均数都会变。", "move": "用移多补少想一想：加进一个 70 分，平均数会往高处移还是往低处移？"},
    {"id": "bsd-one-runner-5b", "name": "只用一个人跑的路程算天数", "why": "忘了全班接力，每天跑的是全班合起来的路程，直接用总路程除以每人每天跑的。", "move": "先问：全班一天一共跑多少千米？把这个数写在总路程旁边，再去除。"},
    {"id": "bsd-six-squares-cube-5b", "name": "以为 6 个正方形都能折成正方体", "why": "只记住正方体有 6 个面，没想折的时候面会不会重叠、有没有空着的面。", "move": "剪 6 个正方形排成一行，当场折一折，看哪里重叠、哪里空着。"},
    {"id": "bsd-pack-small-face-5b", "name": "以为贴住小的面，表面积更小", "why": "觉得接成长长的一条看着整齐，没想到贴住的面越大，藏到里面的部分越多。", "move": "用两个粉笔盒当场摆：贴住大面和贴住小面，各数一数外面还露着哪些面。"},
    {"id": "bsd-pack-sum-same-5b", "name": "以为怎样贴，表面积都一样", "why": "以为两个盒子的表面积加起来不变，没想到贴在一起的两个面藏到了里面。", "move": "两个盒子贴在一起后，让学生数一数：哪两个面看不见了？它们还算在表面积里吗？"},
    {"id": "bsd-remainder-day-dropped-5b", "name": "剩下的路程没再加一天", "why": "只取了商 20（或四舍五入成 20），没想到 20 天后还差 10 km，还得再跑一天。", "move": "问：跑完 20 天一共跑了多少千米？到北京了吗？剩下的 10 km 哪天跑？"}
  ],
